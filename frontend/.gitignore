# ─────────────────────────
# Node / Next.js
# ─────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
.next/
out/
dist/
.turbo/

# Logs & caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# Environment files (never commit secrets)
.env
.env.*
!.env.example
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# ─────────────────────────
# Python / Django
# ─────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Virtual environments (anywhere)
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# Packaging / build artifacts
*.egg-info/
.eggs/
pip-wheel-metadata/

# SQLite (local dev DB only)
db.sqlite3
*.sqlite3
db.sqlite3-journal
*.sqlite3-journal

# Django static/media (if not checking in)
media/
staticfiles/
static/

# Test & tooling caches
.coverage
coverage/
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.pyre/

# ─────────────────────────
# Editors / OS junk
# ─────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# ─────────────────────────
# Misc
# ─────────────────────────
*.pem
.ipynb_checkpoints/
